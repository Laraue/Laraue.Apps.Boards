{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.laraue/boards",
  "description": "List, view, create, edit, delete, link, comment on, and see the history of Laraue Boards issues.",
  "title": "Laraue Boards",
  "version": "4.11.0",
  "websiteUrl": "https://boards.laraue.com",
  "icons": [
    {
      "src": "https://laraue.com/static/images/boards/boards-android-chrome-black-512x512.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    },
    {
      "src": "https://laraue.com/static/images/boards/boards-android-chrome-black-192x192.png",
      "mimeType": "image/png",
      "sizes": ["192x192"]
    }
  ],
  "repository": {
    "url": "https://github.com/Laraue/Laraue.Apps.Boards",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://boards.laraue.com/boards-mcp/mcp",
      "headers": [
        {
          "name": "X-Api-Key",
          "description": "Boards API key - create one from your organization's settings. Not needed by clients that sign in with OAuth.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
