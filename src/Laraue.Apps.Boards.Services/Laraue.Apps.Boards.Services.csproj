    <PackageReference Include="Laraue.Interpreter.Markdown" Version="$(LaraueInterpreterMarkdownVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Laraue.Apps.Boards.DataAccess\Laraue.Apps.Boards.DataAccess.csproj" />
